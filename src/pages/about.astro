---
import SiteLayout from '../layouts/SiteLayout.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site } from '../content/site';
---

<SiteLayout
  title="About"
  description="Meet Alvin Xiao, a software engineer and program manager helping small businesses understand AI and find useful ways to improve everyday work."
>
  <div class="container">
    <section class="page-hero">
      <p class="eyebrow">The human side of technology</p>
      <h1>Hi, I'm Alvin.</h1>
    </section>
    <div class="prose">
      {site.approvals.identity && site.biography ? (
        <>
          <h2>Software engineer. Program manager. Teacher at heart.</h2>
          {site.biography.split('\n\n').map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </>
      ) : (
        <aside class="review-notice">
          <p>
            The personal introduction is being finalized. Biography and professional background
            details will be added after review. See the{' '}
            <a href="/launch-checklist/">launch checklist</a>
            for the remaining steps.
          </p>
        </aside>
      )}
    </div>
  </div>
  <ClosingCTA />
</SiteLayout>
