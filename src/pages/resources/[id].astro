---
import { getCollection, render } from 'astro:content';
import ResourceArtwork from '../../components/ResourceArtwork.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { site } from '../../content/site';
export async function getStaticPaths() {
  return (await getCollection('resources')).map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}
const { article } = Astro.props;
const { Content } = await render(article);
---

<SiteLayout title={article.data.title} description={article.data.description}>
  <div class="container">
    <header class="article-header">
      <a class="text-link" href="/resources/">
        ← All resources
      </a>
      <p class="eyebrow" style="margin-top:35px">
        {article.data.category}
      </p>
      <h1>{article.data.title}</h1>
      <p class="article-meta">By Alvin Xiao</p>
    </header>
    {site.preview && !site.approvals.resources && (
      <aside class="review-notice">
        <p>Prelaunch guide. Final editorial review remains pending.</p>
      </aside>
    )}
    <article class="prose article-body">
      <ResourceArtwork position={article.data.imagePosition} />
      <Content />
    </article>
  </div>
</SiteLayout>
