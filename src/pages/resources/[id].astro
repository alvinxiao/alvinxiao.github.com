---
import { getCollection, render } from 'astro:content';
import ResourceArtwork from '../../components/ResourceArtwork.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { site } from '../../content/site';
import { resolveResourceJourney } from '../../content/resource-journey';
export async function getStaticPaths() {
  const articles = resolveResourceJourney(await getCollection('resources'));
  return articles.map((article, index) => ({
    params: { id: article.id },
    props: { article, previous: articles[index - 1], next: articles[index + 1] },
  }));
}
const { article, previous, next } = Astro.props;
const { Content } = await render(article);
---

<SiteLayout title={article.data.title} description={article.data.description}>
  <div class="container">
    <header class="article-header">
      <a class="text-link" href="/resources/">
        ← All resources
      </a>
      <p class="eyebrow" style="margin-top:35px">
        {article.data.category}
      </p>
      <h1>{article.data.title}</h1>
      <p class="article-meta">By Alvin</p>
    </header>
    {site.preview && !site.approvals.resources && (
      <aside class="review-notice">
        <p>Prelaunch guide. Final editorial review remains pending.</p>
      </aside>
    )}
    <article class="prose article-body">
      <ResourceArtwork position={article.data.imagePosition} />
      <Content />
    </article>
    <nav class="guide-navigation" aria-label="More guides">
      {previous && (
        <a class="guide-link" href={`/resources/${previous.id}/`} rel="prev">
          <span class="guide-direction">← Previous guide</span>
          <span class="guide-title">{previous.data.title}</span>
          <span class="guide-description">{previous.data.description}</span>
        </a>
      )}
      {next && (
        <a class="guide-link guide-next" href={`/resources/${next.id}/`} rel="next">
          <span class="guide-direction">Next guide →</span>
          <span class="guide-title">{next.data.title}</span>
          <span class="guide-description">{next.data.description}</span>
        </a>
      )}
    </nav>
  </div>
</SiteLayout>

<style>
  .article-body {
    padding-bottom: 0;
  }
  .guide-navigation {
    max-width: 760px;
    margin: 40px auto 64px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .guide-link {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 44px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--mist);
  }
  .guide-link:hover {
    border-color: var(--teal);
  }
  .guide-direction {
    color: var(--teal-dark);
    font-size: 1rem;
  }
  .guide-title {
    font-size: 1.375rem;
    line-height: 1.3;
    letter-spacing: -0.035em;
  }
  .guide-description {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
  }
  .guide-next {
    grid-column: 2;
  }
  @media (max-width: 650px) {
    .guide-navigation {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .guide-next {
      grid-column: auto;
    }
  }
</style>
