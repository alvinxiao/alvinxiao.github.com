---
import { getCollection } from 'astro:content';
import ResourceArtwork from '../../components/ResourceArtwork.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Arrow from '../../components/Arrow.astro';
import { site } from '../../content/site';
import { resolveResourceJourney } from '../../content/resource-journey';
const articles = resolveResourceJourney(await getCollection('resources'));
---

<SiteLayout
  title="Resources"
  description="Plain-language guides to understanding AI, trying a small task, and choosing an approach that fits your work."
>
  <div class="container">
    <section class="page-hero">
      <p class="eyebrow">A little understanding goes a long way</p>
      <h1>
        Understand AI.
        <br />
        Try one useful task.
      </h1>
      <p>Learn what AI can do, try a small task, and decide whether it fits your work.</p>
    </section>
    {site.preview && !site.approvals.resources && (
      <aside class="review-notice">
        <p>
          These guides are available for prelaunch review. Final editorial review remains pending.
        </p>
      </aside>
    )}
    <div class="resource-grid" data-reveal-group>
      {articles.map((article) => (
        <a href={`/resources/${article.id}/`} class="resource-card" data-reveal>
          <ResourceArtwork position={article.data.imagePosition} />
          <span class="eyebrow">{article.data.category}</span>
          <h2>{article.data.title}</h2>
          <p>{article.data.description}</p>
          <span class="text-link">
            Read the guide <Arrow />
          </span>
        </a>
      ))}
    </div>
  </div>
</SiteLayout>
