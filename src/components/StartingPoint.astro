---
import Arrow from './Arrow.astro';
import SectionIcon from './SectionIcon.astro';
import { services, serviceHref } from '../content/services';
import { site } from '../content/site';

const choices = [
  { serviceId: 'getting-started', label: "I'd like to understand AI", icon: 'book' },
  { serviceId: 'problem-solving', label: 'I have a specific problem', icon: 'chat' },
  { serviceId: 'workflow-audit', label: 'Something takes too much time', icon: 'workflow' },
] satisfies { serviceId: string; label: string; icon: 'book' | 'chat' | 'workflow' }[];
const startingPoints = choices.map((choice) => {
  const service = services.find(({ id }) => id === choice.serviceId);
  if (!service) throw new Error(`Starting point references missing service: ${choice.serviceId}`);
  return { ...choice, service };
});
---

<section class="starting-point" aria-labelledby="starting-point-heading" data-starting-point>
  <div class="starting-layout container">
    <div class="starting-intro">
      <p class="starting-eyebrow">A good place to begin</p>
      <h2 id="starting-point-heading">
        You don't need a plan.
        <span>Just a starting point.</span>
      </h2>
      <p class="starting-description">
        Choose what sounds most like you. We can work out the details together.
      </p>
      <a class="starting-direct" href="/contact/">
        Or tell me in your own words <Arrow />
      </a>
    </div>
    <div class="starting-chooser">
      <fieldset class="starting-choices">
        <legend>Which sounds most like you?</legend>
        {startingPoints.map((point, index) => (
          <label class="starting-choice" for={`start-${point.service.id}`}>
            <input
              id={`start-${point.service.id}`}
              type="radio"
              name="starting-point"
              value={point.service.id}
              aria-controls={`starting-result-${point.service.id}`}
              checked={index === 0}
            />
            <span>{point.label}</span>
            <span class="starting-choice-icon">
              <SectionIcon name={point.icon} />
            </span>
          </label>
        ))}
      </fieldset>
      <div class="starting-results">
        {startingPoints.map((point) => (
          <section
            id={`starting-result-${point.service.id}`}
            class="starting-result"
            data-starting-result={point.service.id}
            aria-labelledby={`starting-title-${point.service.id}`}
          >
            <p class="result-eyebrow">A place to begin</p>
            <h3 id={`starting-title-${point.service.id}`}>{point.service.name}</h3>
            <p class="result-description">{point.service.summary}</p>
            <div class="result-actions">
              <a class="button starting-contact" href={serviceHref(point.service.id)}>
                Talk about this <Arrow />
              </a>
              <a class="starting-scope" href={`/services/#${point.service.id}`}>
                See what's included <Arrow />
              </a>
            </div>
          </section>
        ))}
      </div>
      {site.prelaunch && (
        <p class="starting-notice">Inquiries open after launch. You can preview the form.</p>
      )}
    </div>
  </div>
</section>

<style>
  .starting-point {
    margin-top: 64px;
    padding-block: clamp(64px, 7vw, 104px);
    background: var(--teal-dark);
    color: var(--canvas);
  }
  .starting-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(40px, 6vw, 96px);
  }
  .starting-intro {
    padding-top: 6px;
  }
  .starting-eyebrow {
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .starting-intro h2 {
    font-size: clamp(44px, 5.2vw, 76px);
    line-height: 1.04;
    letter-spacing: -0.055em;
    font-weight: 400;
    max-width: 10ch;
  }
  .starting-intro h2 span {
    display: block;
    color: var(--peach);
    margin-top: 12px;
  }
  .starting-description {
    font-size: 1.125rem;
    line-height: 1.65;
    max-width: 34ch;
    margin-top: 28px;
  }
  .starting-direct {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    font-size: 1rem;
    margin-top: 20px;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .starting-point :is(a, input):focus-visible {
    outline-color: var(--canvas);
  }
  .starting-choices {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    display: grid;
    gap: 12px;
  }
  .starting-choices legend {
    font-size: 1rem;
    padding: 0;
    margin-bottom: 16px;
  }
  .starting-choice {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) 24px;
    align-items: center;
    gap: 14px;
    padding: 20px;
    border: 1px solid #b7d0c8;
    border-radius: 12px;
    font-size: 1.125rem;
    line-height: 1.4;
    cursor: pointer;
  }
  .starting-choice:hover {
    background: #ffffff0d;
  }
  .starting-choice:has(input:checked) {
    background: var(--peach);
    border-color: var(--peach);
    color: var(--ink);
  }
  .starting-choice:has(input:focus-visible) {
    outline: 3px solid var(--canvas);
    outline-offset: 4px;
  }
  .starting-choice input {
    appearance: none;
    display: block;
    width: 22px;
    height: 22px;
    min-width: 22px;
    margin: 0;
    padding: 0;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    color: inherit;
  }
  .starting-choice input:checked {
    background: var(--ink);
    box-shadow: inset 0 0 0 5px var(--peach);
  }
  .starting-choice input:focus-visible {
    outline: 0;
  }
  .starting-choice-icon {
    display: flex;
  }
  .starting-choice-icon :global(svg) {
    color: inherit;
    width: 24px;
    height: 24px;
  }
  .starting-results {
    display: grid;
    margin-top: 24px;
  }
  .starting-result {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    visibility: hidden;
    opacity: 0;
    transform: translateY(8px);
    border-radius: 16px;
    padding: 28px;
    color: var(--ink);
    background: var(--canvas);
  }
  .starting-point:has(#start-getting-started:checked) [data-starting-result='getting-started'],
  .starting-point:has(#start-problem-solving:checked) [data-starting-result='problem-solving'],
  .starting-point:has(#start-workflow-audit:checked) [data-starting-result='workflow-audit'] {
    visibility: visible;
    opacity: 1;
    transform: none;
  }
  .result-eyebrow {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .starting-result h3 {
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.035em;
    margin: 8px 0 16px;
  }
  .result-description {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 24px;
  }
  .result-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-top: auto;
  }
  .starting-contact {
    background: var(--ink);
    color: var(--canvas);
    font-size: 1rem;
  }
  .starting-scope {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-size: 1rem;
    color: var(--teal-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .starting-result a:focus-visible {
    outline-color: var(--ink);
  }
  .starting-notice {
    color: var(--canvas);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-top: 16px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .starting-result {
      transition:
        opacity 220ms var(--ease-out),
        transform 220ms var(--ease-out);
    }
  }
  @media (forced-colors: active) {
    .starting-choice input,
    .starting-choice input:checked {
      appearance: auto;
      box-shadow: none;
    }
    .starting-choice:has(input:checked) {
      border-color: Highlight;
    }
    .starting-choice:has(input:focus-visible) {
      outline-color: Highlight;
    }
  }
  @media (max-width: 800px) {
    .starting-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .starting-intro h2 {
      max-width: 13ch;
      font-size: clamp(44px, 8vw, 64px);
    }
    .starting-description {
      max-width: 42ch;
    }
  }
  @media (max-width: 400px) {
    .starting-choice {
      padding: 18px 16px;
      gap: 12px;
      font-size: 1rem;
    }
    .starting-result {
      padding: 24px;
    }
    .starting-contact {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
