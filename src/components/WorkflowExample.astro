---
import SectionIcon from './SectionIcon.astro';
import { workflowExample, workflowExamples } from '../content/workflow-example';
---

<section class="workflow-example" aria-labelledby="worked-example-heading">
  <h3 id="worked-example-heading">{workflowExample.title}</h3>
  <p class="worked-example-caveat">{workflowExample.caveat}</p>
  <fieldset>
    <legend>{workflowExample.legend}</legend>
    <div class="workflow-example-choices">
      {workflowExamples.map((example, index) => (
        <label>
          <input
            type="radio"
            name="workflow-example-need"
            id={`worked-example-${example.id}`}
            value={example.id}
            checked={index === 0}
            aria-controls={`worked-example-panel-${example.id}`}
          />
          <span>{example.need}</span>
        </label>
      ))}
    </div>
    <div class="workflow-example-panels">
      {workflowExamples.map((example) => (
        <section
          class="workflow-example-panel"
          id={`worked-example-panel-${example.id}`}
          data-case={example.id}
          aria-labelledby={`worked-example-heading-${example.id}`}
        >
          <div class="customer-question">
            <SectionIcon name="chat" />
            <p>{example.question}</p>
          </div>
          <div class="reply-flow">
            <div class="source-card">
              <p class="source-label">
                <SectionIcon name="document" />
                {example.sourceLabel}
              </p>
              <p class="source-fact">{example.fact}</p>
            </div>
            <div class="reply-connector" aria-hidden="true">
              <svg class="horizontal" viewBox="0 0 40 24" fill="none">
                <path class="connector-track" d="M1 12h35" />
                <path class="connector-trace" pathLength="100" d="M1 12h35" />
                <path d="m29 6 7 6-7 6" />
              </svg>
              <svg class="vertical" viewBox="0 0 24 28" fill="none">
                <path class="connector-track" d="M12 1v23" />
                <path class="connector-trace" pathLength="100" d="M12 1v23" />
                <path d="m6 18 6 6 6-6" />
              </svg>
            </div>
            <div class="reply-card">
              <h4 id={`worked-example-heading-${example.id}`}>
                <SectionIcon name="chat" />
                <span>{example.approach}</span>
              </h4>
              <p>{example.reply}</p>
            </div>
          </div>
          <p class="reply-note">
            <SectionIcon name="check" />
            <span>{example.note}</span>
          </p>
        </section>
      ))}
    </div>
  </fieldset>
  <a class="workflow-example-guide" href={workflowExample.guideHref}>
    {workflowExample.guideTitle} <span aria-hidden="true">→</span>
  </a>
</section>

<style>
  .workflow-example {
    margin-bottom: 32px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #fffdf8;
  }
  h3 {
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.035em;
    font-weight: 500;
    margin: 0 0 8px;
  }
  .worked-example-caveat {
    font-size: 15px;
    color: var(--muted);
    margin: 0 0 24px;
  }
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  legend {
    font-size: 17px;
    margin: 0 0 14px;
    padding: 0;
  }
  .workflow-example-choices {
    display: none;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 24px;
  }
  label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 0;
    min-height: 48px;
    padding: 12px 10px;
    border: 1px solid #a4b9b1;
    background: var(--canvas);
    border-radius: 10px;
    font-size: 15px;
    font-weight: 400;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }
  label:hover {
    background: var(--mist);
  }
  label:has(input:checked) {
    box-shadow: inset 0 0 0 1px var(--teal-dark);
    border-color: var(--teal-dark);
    background: var(--mist);
  }
  input {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin: 0;
    accent-color: var(--teal-dark);
  }
  input:focus-visible {
    outline: 3px solid var(--teal-dark);
    outline-offset: 4px;
  }
  .workflow-example-panel {
    min-width: 0;
  }
  .workflow-example-panel + .workflow-example-panel {
    margin-top: 28px;
  }
  .customer-question {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin: 0 0 18px;
    padding: 0 0 18px;
    border-bottom: 1px solid var(--line);
  }
  .customer-question :global(svg) {
    color: var(--teal);
    margin-top: 2px;
  }
  .customer-question p {
    font-size: 19px;
    line-height: 1.4;
    max-width: 50ch;
    margin: 0;
  }
  .reply-flow {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) 40px minmax(0, 1.3fr);
    gap: 12px;
    align-items: stretch;
  }
  .source-card {
    padding: 18px;
    background: #f0f4f0;
    border-radius: 10px;
    border: 1px solid var(--line);
    min-width: 0;
  }
  .source-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .source-fact {
    font-size: 18px;
    line-height: 1.4;
    margin: 0;
  }
  .reply-card {
    background: var(--teal-dark);
    border-radius: 12px;
    padding: 20px;
    color: #fffdf8;
    min-width: 0;
  }
  h4 {
    font-size: 15px;
    color: var(--mist);
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    font-weight: 400;
    line-height: 1.3;
  }
  .reply-card p {
    font-size: 19px;
    line-height: 1.45;
    margin: 0;
  }
  .reply-card :global(.section-icon) {
    color: inherit;
  }
  .reply-note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: var(--muted);
    margin: 16px 0 0;
  }
  .reply-note :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--teal);
  }
  .workflow-example :global(.section-icon) {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .reply-connector {
    color: var(--teal);
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .reply-connector svg {
    width: 40px;
    height: 24px;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .reply-connector .vertical {
    display: none;
  }
  .connector-track {
    opacity: 0.22;
  }
  .connector-trace {
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }
  .workflow-example-guide {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    min-height: 44px;
    margin-top: 24px;
    font-size: 15px;
    color: var(--teal-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @supports selector(:has(*)) and (grid-template-rows: subgrid) {
    .workflow-example-choices {
      display: grid;
    }
    .workflow-example-panels {
      display: grid;
      grid-template-rows: repeat(3, auto);
    }
    .workflow-example-panel {
      display: grid;
      grid-template-rows: subgrid;
      grid-column: 1;
      grid-row: 1 / span 3;
      visibility: hidden;
      pointer-events: none;
    }
    .workflow-example-panel + .workflow-example-panel {
      margin-top: 0;
    }
    .workflow-example:has(input[value='hours']:checked) [data-case='hours'],
    .workflow-example:has(input[value='status']:checked) [data-case='status'],
    .workflow-example:has(input[value='request']:checked) [data-case='request'] {
      visibility: visible;
      pointer-events: auto;
    }
    @media (prefers-reduced-motion: no-preference) {
      .workflow-example:has(input[value='hours']:checked) [data-case='hours'] .connector-trace,
      .workflow-example:has(input[value='status']:checked) [data-case='status'] .connector-trace,
      .workflow-example:has(input[value='request']:checked) [data-case='request'] .connector-trace {
        animation: reply-connection 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
      }
    }
  }
  @keyframes reply-connection {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 650px) {
    .workflow-example {
      padding: 20px 16px;
    }
    h3 {
      font-size: 26px;
    }
    .workflow-example-choices {
      gap: 8px;
    }
    label {
      flex-direction: column;
      padding: 10px 5px;
      gap: 6px;
      text-align: center;
      line-height: 1.2;
    }
    .reply-flow {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .reply-connector .horizontal {
      display: none;
    }
    .reply-connector .vertical {
      display: block;
      width: 24px;
      height: 28px;
    }
    @supports selector(:has(*)) and (grid-template-rows: subgrid) {
      .workflow-example-panels {
        grid-template-rows: repeat(5, auto);
        row-gap: 12px;
      }
      .workflow-example-panel {
        grid-row: 1 / span 5;
      }
      .customer-question {
        grid-row: 1;
        margin-bottom: 6px;
      }
      .reply-flow {
        display: contents;
      }
      .source-card {
        grid-row: 2;
      }
      .reply-connector {
        grid-row: 3;
      }
      .reply-card {
        grid-row: 4;
      }
      .reply-note {
        grid-row: 5;
        margin-top: 4px;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    label {
      transition: none;
    }
  }
</style>
