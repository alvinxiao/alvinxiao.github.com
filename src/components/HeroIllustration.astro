---
import Arrow from './Arrow.astro';
import SectionIcon from './SectionIcon.astro';
---

<figure class="workflow-illustration" aria-labelledby="workflow-caption">
  <figcaption id="workflow-caption">An example: answering a customer question</figcaption>
  <ol class="workflow-steps">
    <li>
      <span class="workflow-number">
        <SectionIcon name="chat" />
        01 · The question
      </span>
      <h2>Customer question</h2>
      <p>“Can I collect my order on Saturday?”</p>
      <Arrow />
    </li>
    <li>
      <span class="workflow-number">
        <SectionIcon name="document" />
        02 · AI helps draft
      </span>
      <h2>Draft response</h2>
      <p>Use your pickup policy to prepare a reply.</p>
      <Arrow />
    </li>
    <li>
      <span class="workflow-number">
        <SectionIcon name="check" />
        03 · You decide
      </span>
      <h2>Review and send</h2>
      <p>Check the details. Make it sound like you.</p>
    </li>
  </ol>
  <p class="workflow-footnote">AI prepares a draft. You keep the final say.</p>
  <label class="workflow-motion-control">
    <input type="checkbox" />
    Pause workflow animation
  </label>
</figure>

<script>
  import '../scripts/workflow';
</script>
